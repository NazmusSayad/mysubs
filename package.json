{
  "name": "mysubs",
  "version": "0.1.1",
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "tsdown --config ./tsdown.config.ts",
    "dev": "tsdown --config ./tsdown.config.ts --watch",
    "start": "tsx ./src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": {
    "mysubs": "dist/index.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.9.5",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "concurrently": "^10.0.4",
    "daily-code": "^1.1.16",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-oxfmt": "^0.28.0",
    "husky": "^9.1.7",
    "ms": "^2.1.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NazmusSayad/mysubs.git"
  }
}

{
  "name": "mysubs",
  "version": "0.0.15",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "tsdown --config ./tsdown.config.ts",
    "dev": "tsdown --config ./tsdown.config.ts --watch",
    "start": "tsx ./src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": {
    "mysubs": "dist/index.mjs"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@types/ms": "^2.1.0",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "concurrently": "^10.0.4",
    "daily-code": "^1.1.16",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "ms": "^2.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsdown": "^0.22.14",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NazmusSayad/mysubs.git"
  }
}
